<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CrazyNumbers"
             Shell.NavBarIsVisible="False"
             x:Class="CrazyNumbers.MainPage">

    <Grid>
        <!-- Start Screen -->
        <ScrollView x:Name="StartScreen" IsVisible="True" Padding="20">
            <VerticalStackLayout Spacing="20" HorizontalOptions="Center" MaximumWidthRequest="700">
                <Label Text="Welcome to CRAZY NUMBERS" 
                       FontSize="25" TextColor="#aa0000" HorizontalOptions="Center" FontAttributes="Bold" />
                
                <Button Text="VIEW GAME RULES" Clicked="OnRulesClicked" BackgroundColor="#aaaa00" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" WidthRequest="200" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="20" VerticalOptions="Center" Margin="0,40,0,0">
                    <Label Text="Number of rounds:" VerticalOptions="Center" FontSize="18" FontAttributes="Bold" />
                    <Picker x:Name="RoundsPicker" SelectedIndex="0" WidthRequest="150" HeightRequest="50" FontSize="18">
                        <Picker.Items>
                            <x:String>5</x:String>
                            <x:String>6</x:String>
                            <x:String>7</x:String>
                            <x:String>8</x:String>
                            <x:String>9</x:String>
                            <x:String>10</x:String>
                            <x:String>11</x:String>
                            <x:String>12</x:String>
                        </Picker.Items>
                    </Picker>
                </HorizontalStackLayout>
                <Button Text="PLAY" Clicked="OnPlayClicked" BackgroundColor="#00aaaa" TextColor="White" FontAttributes="Bold" HeightRequest="50" WidthRequest="100" FontSize="18" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Game Screen -->
        <Grid x:Name="GameScreen" IsVisible="False" Padding="10" RowDefinitions="Auto,*,Auto,Auto,Auto">
            
            <!-- Top Panel: 4 Columns (Players + Round) -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" HorizontalOptions="Fill" Padding="10" ColumnSpacing="5">
                <!-- Player 1 Column -->
                <Border Grid.Column="0" x:Name="Player1ColBorder" Padding="5" StrokeThickness="2" Stroke="Transparent">
                    <VerticalStackLayout>
                        <Label x:Name="Player1Header" Text="Player 1" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label x:Name="Score1Lbl" Text="0" FontSize="20" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Player 2 Column -->
                <Border Grid.Column="1" x:Name="Player2ColBorder" Padding="5" StrokeThickness="2" Stroke="Transparent">
                    <VerticalStackLayout>
                        <Label x:Name="Player2Header" Text="Player 2" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label x:Name="Score2Lbl" Text="0" FontSize="20" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Player 3 Column -->
                <Border Grid.Column="2" x:Name="Player3ColBorder" Padding="5" StrokeThickness="2" Stroke="Transparent">
                    <VerticalStackLayout>
                        <Label x:Name="Player3Header" Text="Player 3" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label x:Name="Score3Lbl" Text="0" FontSize="20" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Round Column -->
                <Border Grid.Column="3" Padding="5" StrokeThickness="2" Stroke="Transparent">
                    <VerticalStackLayout>
                        <Label Text="Round" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label x:Name="RoundLbl" Text="1/5" FontSize="20" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Main Board -->
            <Grid Grid.Row="1" HorizontalOptions="Center" VerticalOptions="Center" 
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="5" RowSpacing="5" x:Name="BoardGrid">
                <!-- Generated dynamically in code-behind -->
            </Grid>
            
            <!-- Calculation & Tip Panel -->
            <VerticalStackLayout Grid.Row="2" Spacing="5" Padding="5" Margin="0">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,5">
                    <Border x:Name="Factor1Border" BackgroundColor="#00aaaa" Padding="10" WidthRequest="40" HeightRequest="40" Stroke="Black">
                        <Label x:Name="Factor1Lbl" Text="5" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Black" FontAttributes="Bold" />
                    </Border>
                    <Label Text="x" VerticalOptions="Center" FontSize="18" />
                    <Border x:Name="Factor2Border" BackgroundColor="White" Padding="10" WidthRequest="40" HeightRequest="40" Stroke="Black">
                        <Label x:Name="Factor2Lbl" Text="?" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Black" FontAttributes="Bold" />
                    </Border>
                </HorizontalStackLayout>
                <Label x:Name="TipLbl" Text="Select a multiplier from the bottom panel." HorizontalOptions="Center" FontSize="16" FontAttributes="Italic" TextColor="Gray" Margin="0" />
            </VerticalStackLayout>

            <!-- Bottom Panel: Factors to choose from -->
            <FlexLayout Grid.Row="3" x:Name="FactorsGrid" Wrap="Wrap" JustifyContent="Center" AlignItems="Center" Padding="0" Margin="0,20">
                <!-- Generated dynamically in code-behind -->
            </FlexLayout>

            <!-- Action Buttons (Rules & Reset) -->
            <HorizontalStackLayout Grid.Row="4" HorizontalOptions="Center" Spacing="20" Margin="0,5">
                <Button Text="RULES" Clicked="OnRulesClicked" BackgroundColor="#aaaa00" TextColor="White" HeightRequest="40" WidthRequest="100" FontAttributes="Bold" />
                <Button Text="RESET" Clicked="OnResetClicked" BackgroundColor="#aa0000" TextColor="White" HeightRequest="40" WidthRequest="100" FontAttributes="Bold" />
            </HorizontalStackLayout>

            <!-- Game Over Overlay -->
            <ContentView x:Name="GameOverOverlay" IsVisible="False" BackgroundColor="#CCFFFFFF" Grid.RowSpan="5">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
                    <Label Text="Game Over!" FontSize="30" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" />
                    <VerticalStackLayout x:Name="WinnersContainer" Spacing="10" HorizontalOptions="Center" />
                    <Button Text="NEW GAME" Clicked="OnNewGameClicked" BackgroundColor="#00aaaa" TextColor="White" FontAttributes="Bold" />
                </VerticalStackLayout>
            </ContentView>
            
        </Grid>

        <!-- Rules Popup Overlay -->
        <local:RulesView x:Name="RulesPopup" IsVisible="False" Grid.RowSpan="4" CloseRequested="OnRulesCloseRequested" />
    </Grid>
</ContentPage>
