<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:CrazyNumbers.Resources.Strings"
             x:Class="CrazyNumbers.RulesPage"
             Shell.NavBarIsVisible="False"
             Title="{x:Static strings:AppResources.RulesTitle}">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0F19" Offset="0.0" />
            <GradientStop Color="#16132A" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView VerticalOptions="Center" HorizontalOptions="Center">
        <VerticalStackLayout Spacing="25" Padding="30" HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="600">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15" VerticalOptions="Center">
                <Button Grid.Column="0" Text="←" Clicked="OnBackClicked" BackgroundColor="Transparent" TextColor="White" FontSize="24" FontAttributes="Bold" WidthRequest="50" HeightRequest="50" CornerRadius="25" />
                <Label Grid.Column="1" Text="{x:Static strings:AppResources.RulesTitle}" FontSize="28" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
            </Grid>

            <!-- Rules Card -->
            <Border Stroke="#33ffffff" StrokeThickness="1" BackgroundColor="#15ffffff" Padding="25" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{x:Static strings:AppResources.RulesSubtitle}" FontSize="20" FontAttributes="Bold" TextColor="#ffd600" Margin="0,0,0,10" />

                    <Label Text="{x:Static strings:AppResources.RulesPlayersRule}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{x:Static strings:AppResources.RulesPlayersDescription}" TextColor="#d0d0d0" FontSize="14" Margin="0,0,0,10" />

                    <Label Text="{x:Static strings:AppResources.RulesScoringTitle}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{x:Static strings:AppResources.RulesScoringDescription}" TextColor="#d0d0d0" FontSize="14" Margin="0,0,0,10" />

                    <Label Text="{x:Static strings:AppResources.RulesHowToPlayTitle}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{x:Static strings:AppResources.RulesHowToPlayDescription}" TextColor="#d0d0d0" FontSize="14" LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <!-- OK Button -->
            <Button Text="{x:Static strings:AppResources.GotItButton}" 
                    Clicked="OnBackClicked" 
                    BackgroundColor="#00e5ff" 
                    TextColor="#0B0F19" 
                    FontAttributes="Bold" 
                    FontSize="16" 
                    HeightRequest="50" 
                    CornerRadius="25"
                    WidthRequest="160"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
