<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CrazyNumbers.RulesView"
             BackgroundColor="#CCFFFFFF">
    
    <Border BackgroundColor="White" Stroke="Black" StrokeThickness="2"
            VerticalOptions="Center" HorizontalOptions="Center" 
            Padding="20" Margin="20" MaximumWidthRequest="600">
        <VerticalStackLayout Spacing="15">
            <Label Text="CRAZY NUMBERS RULES" 
                   FontSize="20" FontAttributes="Bold" TextColor="#aa0000" HorizontalOptions="Center" />
            
            <ScrollView MaximumHeightRequest="300">
                <Label Text="This is a game modeled after a math competition from a youth TV show called CRAZY NUMBERS - ZIGZAG. The game is for three players, whose task is to provide products in such a way that the fields they occupy on the board are adjacent to each other.&#10;&#10;For occupying two fields diagonally, you receive 20 points. As a one-time bonus, you can receive 30 points for occupying three fields vertically or horizontally.&#10;&#10;Your task is to select the second factor (green numbers at the bottom), and then the product on the white board. The winner is the one who gets the most points.&#10;&#10;Calculate and WIN !!!"
                       FontSize="14" HorizontalTextAlignment="Justify" TextColor="Black" />
            </ScrollView>
            
            <Button Text="CLOSE" Clicked="OnCloseClicked" BackgroundColor="#00aaaa" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" WidthRequest="120" />
        </VerticalStackLayout>
    </Border>
</ContentView>
